# ===========================
# MODE (development | production)
# production: backend serve frontend dist, tidak perlu jalankan frontend dev server
# development: frontend dan backend jalan terpisah
# ===========================
NODE_ENV=development

# ===========================
# DATABASE
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meeting_manager
DB_USER=postgres
DB_PASSWORD=your_password_here

# ===========================
# AUTH
# ===========================
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# ===========================
# GOOGLE SSO
# Buat OAuth 2.0 Client ID di https://console.cloud.google.com
# Tipe: Web application
# Authorized redirect URIs: http://localhost:5173
# ===========================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ===========================
# URLS
# development : FRONTEND_URL=http://localhost:5173
# production  : FRONTEND_URL=http://localhost:3001 (atau domain server)
# ===========================
PORT=3001
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# ===========================
# EMAIL - RESEND
# Daftar di https://resend.com
# ===========================
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=rapat@yourdomain.com

# ===========================
# WHATSAPP - FONNTE
# Daftar di https://fonnte.com
# ===========================
FONNTE_TOKEN=your_fonnte_token_here
